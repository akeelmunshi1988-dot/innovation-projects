<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dreamrugs.room-visualizer</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/RugManufactureCustomApp/backend/venv/bin/python</string>
    <string>/Applications/RugManufactureCustomApp/automation/room_visualizer_agent.py</string>
    <string>--watch-dir</string>
    <string>/Users/user/Downloads/GoogleDriveHarisPhotos</string>
    <string>--env-file</string>
    <string>/Applications/RugManufactureCustomApp/backend/.env</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Applications/RugManufactureCustomApp</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Applications/RugManufactureCustomApp/automation/room-visualizer.log</string>
  <key>StandardErrorPath</key>
  <string>/Applications/RugManufactureCustomApp/automation/room-visualizer.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
