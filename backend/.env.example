ANTHROPIC_API_KEY=sk-ant-your-key-here
# Powers the "inspire from a room photo" rug matcher — not the vendor AI Assistant
# Required for the vendor AI Assistant page (Settings > "AI Assistant for Vendor/Staff").
# Also optionally enables the "AI-enhanced lighting" toggle on the room visualizer.
OPENAI_API_KEY=sk-your-key-here
DATABASE_URL=sqlite:///./rug_manufacture.db

# SMTP (used for quote/invoice/verification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DreamRugsCreation

# Base URL of the customer-facing frontend, used to build links in emails (e.g. email verification)
FRONTEND_URL=http://localhost:5173
# Base URL of this backend API — used to build the OAuth redirect_uri registered with each provider below
BACKEND_URL=http://localhost:8000

# Optional. When set, gates the whole site (via nginx auth_request — see
# DEPLOYMENT.md) to visitors browsing from India unless they hold this key,
# e.g. via https://yourdomain.com/?key=<this value>. Leave empty to disable
# the gate entirely — nothing is blocked by default. Generate with:
#   openssl rand -hex 24
INDIA_ACCESS_KEY=

# Social login (customer accounts) — each is optional; a provider's "Continue with..."
# button only appears on the storefront once both its ID and Secret are set here.
# Register an app in each provider's developer console and set its authorized
# redirect URI to: {BACKEND_URL}/api/auth/customer/oauth/{provider}/callback
#   Google:   https://console.cloud.google.com/apis/credentials
#   Facebook: https://developers.facebook.com/apps
#   LinkedIn: https://www.linkedin.com/developers/apps  (enable "Sign In with LinkedIn using OpenID Connect")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
